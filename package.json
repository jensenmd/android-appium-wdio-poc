{
  "name": "outside-mobile-qa-poc",
  "version": "1.0.0",
  "description": "Small Android mobile QA proof-of-concept using Appium, WebdriverIO, and TypeScript.",
  "private": true,
  "scripts": {
    "appium": "appium --base-path /",
    "check": "tsc --noEmit",
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "android",
    "qa"
  ],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@wdio/cli": "^9.31.4",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "webdriverio": "^9.31.4"
  }
}
